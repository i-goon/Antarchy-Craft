	quest.2A18298BCEFDA045.title: "Double Chest Pet"
	quest.2B4F57775E452281.quest_desc: ["Knockback, plus a supply of snowballs."]
	quest.2B4F57775E452281.title: "Snow Golem Pet"
	quest.2C8724D1B5322F15.quest_desc: ["Ride a red ant out of the Nether - or kill one inside a Nyxite portal frame.", "A nightmare dimension of inverted gravity: plants, geysers and pools fling you skyward.", 		"The Nightmare, the Emperor Scorpion, the Lucid and the Bed Bugs live here. The Queen rules the Underside below."
		"Nature's Compass tracks Thoraxis biomes by name - try Nightmare Wastes."]
	quest.2C8724D1B5322F15.title: "Thoraxis"
	quest.2D8E992843D88ED6.quest_desc: ["Ride a mob, and fly while riding."]
	quest.2D8E992843D88ED6.title: "Flying Saddle Pet"
	quest.2DD4D02B05BFFB76.quest_desc: ["Teleports you to the End, and back."]
	quest.2DD4D02B05BFFB76.title: "End Portal Pet"
	quest.2DE8C1417D853B24.quest_desc: ["Pick a structure and it points you to the nearest one.", "Crafted from a Biome Pet and a Pingot Pet."]
	quest.2DE8C1417D853B24.title: "Dingot Pet"
	quest.2E01DB27775963D4.quest_desc: ["Pushes cell stock out to machines.", "Crafting cards make it request on demand."]
