	quest.1001AABBCCDDEEFF.quest_desc: [
		"The first boss of the Twilight Forest."
		"Find the Naga Courtyard in the forest. The Naga circles the arena and charges through blocks. Bring a shield and keep moving."
	]
	quest.1001AABBCCDDEEFF.title: "The Naga"
	quest.1002AABBCCDDEEFF.quest_desc: [
		"At the top of the Lich Tower."
		"Three phases. Reflect his Ender Pearl shots to break the shields, melee him when he summons zombies, then finish him when he swaps to a sword."
	]
	quest.1002AABBCCDDEEFF.title: "The Twilight Lich"
	quest.1003AABBCCDDEEFF.quest_desc: [
		"The Labyrinth under the Swamp."
		"Use a Maze Map or follow the walls to find the Minoshroom. Eat the Meef Stroganoff it drops to unlock the Fire Swamp."
	]
	quest.1003AABBCCDDEEFF.title: "Minoshroom"
	quest.1004AABBCCDDEEFF.quest_desc: [
		"In the Fire Swamp."
		"The Hydra has many heads. Ranged is weak so fight up close and keep moving to avoid fire. Defeating it opens the Dark Forest."
	]
	quest.1004AABBCCDDEEFF.title: "Hydra"
	quest.1005AABBCCDDEEFF.quest_desc: [
		"Inside the Dark Forest Stronghold."
		"Place any boss trophy on the pedestal to enter. Six Knight Phantoms fight together on the third layer."
	]
	quest.1005AABBCCDDEEFF.title: "Knight Phantoms"
	quest.1006AABBCCDDEEFF.quest_desc: [
		"At the top of the Dark Tower."
		"Find the reappearing blocks at the base to climb the maze. Ghast traps powered by Ghastlings can help, a bow works too."
	]
	quest.1006AABBCCDDEEFF.title: "Ur-Ghast"
	quest.1007AABBCCDDEEFF.quest_desc: [
		"In the Snowy Forest."
		"Find the large Yeti Cave. The Alpha Yeti throws ice blocks, a bow helps."
	]
	quest.1007AABBCCDDEEFF.title: "Alpha Yeti"
	quest.1008AABBCCDDEEFF.quest_desc: [
		"At the top of the Aurora Palace in the Glacier."
		"She summons ice crystals and slams ice that breaks the floor. Hit her upper half while dodging. Defeating her unlocks the Highlands."
	]
	quest.1008AABBCCDDEEFF.title: "Snow Queen"
	quest.10845E332C012581.quest_desc: ["It forms the core of Big Bertha's blade."]
	quest.10845E332C012581.title: "The Ultimate Sword"
	quest.17BE13E24CD644E5.quest_desc: [
		"Now the actual fight starts, he has two health bars both need to get taken to 0 to get the Chaos Shards. Don't get too close or he'll hit you with a barrage of Fireballs!"
		"(BTW in older versions the Chaos Guardian could even kill someone in Creative mode! Fortunately it can't anymore)"
	]
	quest.17BE13E24CD644E5.title: "Kill the Chaos Guardian"
