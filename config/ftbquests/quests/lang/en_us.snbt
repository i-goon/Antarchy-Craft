	quest.475DDABE8D57F989.title: "Molecular Assembler"
	quest.483B6AF583A73905.quest_desc: ["Mekanism's item pipes, in four tiers from basic to ultimate.", "Configure both ends with the configurator. The logistical sorter adds single-item routing later."]
	quest.483B6AF583A73905.title: "Logistical Transporters"
	quest.48A2A4D44D3E72AB.quest_desc: ["Summons and stows minions that fight for you."]
	quest.48A2A4D44D3E72AB.title: "Quantum Crystal Monster Pet"
	quest.48B38A199C0690E6.quest_desc: ["Water breathing, underwater vision and a swim boost."]
	quest.48B38A199C0690E6.title: "Squid Pet"
	quest.49AA40492696BCA0.quest_desc: ["Vacuums nearby drops straight into the backpack. Turn it off before walking past a friend's build site."]
	quest.49AA40492696BCA0.title: "Magnet Upgrade"
	quest.4A48C9233678C0E2.quest_desc: ["Collect every one of the peaceful pets around this quest."]
	quest.4A48C9233678C0E2.title: "Peaceful Pets"
	quest.4A9C9D5C3303E80E.quest_desc: ["Holds ten storage cells where the network keeps items.", "Cells come in tiers; start small."]
	quest.4A9C9D5C3303E80E.title: "ME Drive"
	quest.4B7A9E79D4CAE2E1.quest_desc: ["Collect every one of the mob pets around this quest."]
	quest.4B7A9E79D4CAE2E1.title: "Mob Pets"
	quest.4BC8C8F0B0ADFCA2.quest_desc: ["Explode on command, and stay immune to explosions."]
	quest.4BC8C8F0B0ADFCA2.title: "Creeper Pet"
	quest.4BDE0496932034F8.quest_desc: ["One block that pushes, pulls and filters with swappable modules, perfect for compact automation.", "It works on the six adjacent blocks out of the box. Range and stack upgrades come later."]
	quest.4BDE0496932034F8.title: "Modular Routers"
	quest.4D84B1D48D2BC8EC.quest_desc: ["Pulls power out of the network into machines.", "Set limits per point so one hungry machine cannot brown out the base."]
	quest.4D84B1D48D2BC8EC.title: "Flux Point"
	quest.4D924EDBBBAA90E2.quest_desc: ["Dropped by the Brutalfly."]
	quest.4D924EDBBBAA90E2.title: "Brutalfly Wing"
	quest.4DA1CB466F30CB23.quest_desc: ["Nightmare scale, Molevore nose, Jerry nucleus, Hercules horn, Springbug leg, Primordial scute, Rainbow Sugar.", "Seven drops, one grip."]
	quest.4DA1CB466F30CB23.title: "Big Bertha Hilt"
	quest.4DF4CCA612E87BC1.quest_desc: ["Thirty seconds of insta-shot, plus arrows."]
	quest.4DF4CCA612E87BC1.title: "Quiver Pet"
	quest.4F15A97C2B78C20C.quest_desc: ["Dropped by the Emperor Scorpion."]
	quest.4F15A97C2B78C20C.title: "Emperor Scorpion Stinger"
	quest.4F87D484CF50F980.quest_desc: ["Health regeneration, and fills empty buckets with lava."]
	quest.4F87D484CF50F980.title: "Purplicious Cow Pet"
	quest.4FB4D4E4ACC2BC58.quest_desc: ["The biggest chest in the line, with the most upgrade slots."]
	quest.4FB4D4E4ACC2BC58.title: "Netherite Chest"
	quest.52135CB13CCC38B7.quest_desc: ["Craft an AntOS Computer and slot in the floppy disks you find.", "Boss records cover where each boss lives and how it fights; the King and Queen records list coordinates.", "Disks turn up in structure chests and from the Computer Scientist villager.", "Once the Ender Dragon is dead, an Explorer's Compass finds the boss lairs faster."]
	quest.52135CB13CCC38B7.title: "Boss Records"
	quest.531A0D00CEB93836.quest_desc: ["Pipes filter with an Advanced Upgrade installed: open the pipe GUI, add a filter, then set item, tag or NBT.", "The destination tool locks a filter to one specific inventory. Whitelist lets only the filter through, blacklist everything but."]
	quest.531A0D00CEB93836.title: "Pipe Filtering"
	quest.53689B826F46C9AF.quest_desc: ["It guards its arena in the Elythia ocean.", "Its scute feeds the Big Bertha hilt."]
	quest.53689B826F46C9AF.title: "Kill the Toreterror"
	quest.53DB7377C211654A.quest_desc: ["Right-click a brown ant to be pulled into Elythia, hunting ground of the Brutalfly, the Toreterror, the Basilisk, the Molevore, the Stratoshark, the Alpha Mantis and the King."]
	quest.53DB7377C211654A.title: "Elythia"
	quest.543BAE83CA014862.quest_desc: ["A crafting grid living inside the chest.", "Stonecutting and smelting variants exist too."]
	quest.543BAE83CA014862.title: "Crafting Upgrade"
	quest.54F000B24088BB6C.quest_desc: ["The Kraken drops both Tentacles and Teeth - you need one of each."]
	quest.54F000B24088BB6C.title: "Release the Kraken"
	quest.55A4EED273996F9B.quest_desc: ["A quarter-million item types in one cell.", "The end of the line. Probably."]
	quest.55A4EED273996F9B.title: "256k Storage Cell"
	quest.56470DD6A6B6B8AE.quest_desc: ["Slow fall, plus wool."]
	quest.56470DD6A6B6B8AE.title: "Sheep Pet"
	quest.567DF821E2727EF2.quest_desc: ["It patrols the cloud seas of Elythia.", "Its fin feeds the Big Bertha blade - and cooks into a fine soup."]
	quest.567DF821E2727EF2.title: "Kill the Stratoshark"
	quest.570FA365734D9D59.quest_desc: ["Moves fluids for machines like the electrolytic separator, which drinks water.", "Higher tiers carry more per tick."]
	quest.570FA365734D9D59.title: "Mechanical Pipes"
	quest.571814A9A148A680.quest_desc: ["Brews a random potion."]
	quest.571814A9A148A680.title: "Brewing Stand Pet"
	quest.574FF91C2BA5B3EE.quest_desc: ["Everything here stores items without power: cans, drawers, chests and backpacks.", "Digital storage closes the chapter for when the chest room overflows."]
	quest.574FF91C2BA5B3EE.title: "Basic Storage"
	quest.57DEC97B2439F380.quest_desc: ["Packs up a machine, contents and settings included, for moving day.", "Does not work on everything, but on most things that matter."]
	quest.57DEC97B2439F380.title: "Cardboard Box"
	quest.58E9F2D694C5AACF.quest_desc: ["A terminal with crafting built in.", "Craft straight out of the cells."]
	quest.58E9F2D694C5AACF.title: "Crafting Terminal"
	quest.59B10BA13662C356.quest_desc: ["Getting rid of the excess. One can each for items, fluids and energy.", "Void upgrades later do the same job inline, but a can by the workbench never hurts."]
	quest.59B10BA13662C356.title: "Trash Cans"
	quest.5A2BB3FE519904B0.quest_desc: ["Throw it, and it comes back on its own."]
	quest.5A2BB3FE519904B0.title: "Banana Pet"
	quest.5C87B4ED20485B96.quest_desc: ["Mantis claw, Brutalfly wing, Flytrap goo, a cooked corndog, and the whole Gravity Gun.", "Yes, the gun gets consumed. Worth it."]
	quest.5C87B4ED20485B96.title: "Big Bertha Handle"
	quest.5D5293C66B777AB7.quest_desc: ["Protects nearby allies and tamed pets."]
	quest.5D5293C66B777AB7.title: "Shield Pet"
	quest.5DA1AD8E6FEBCD1F.quest_desc: ["Four netherite scrap plus four gold ingots on the crafting grid.", "The blade project needs its backbone metal."]
	quest.5DA1AD8E6FEBCD1F.title: "Netherite Ingot"
	quest.5DFA0469CBFF181C.quest_desc: ["Leashes and tames a mob."]
	quest.5DFA0469CBFF181C.title: "Lead Pet"
	quest.5E0943EE854B447E.quest_desc: ["Sleep anywhere.", "Can summon a living bed."]
	quest.5E0943EE854B447E.title: "Bed Pet"
	quest.5E1B1EDC40B2FDAE.quest_desc: ["Connects two inventories and moves items between them, farm to chest or chest to machine.", "Wrench a pipe to set each side to Pull, Push or Off."]
	quest.5E1B1EDC40B2FDAE.title: "Item Pipez"
	quest.5E2317898835EEB5.quest_desc: ["Saves you from certain death, and gives slimeballs."]
	quest.5E2317898835EEB5.title: "Slime Pet"
	quest.5EFFD7F90347D84C.quest_desc: ["Strength boost, and your attacks set enemies on fire."]
	quest.5EFFD7F90347D84C.title: "Blaze Pet"
	quest.5F5E45EFACDCE9A6.quest_desc: ["Smelt titanium ore."]
	quest.5F5E45EFACDCE9A6.title: "Titanium Ingot"
	quest.6091AE070476DB48.quest_desc: ["Wireless redstone between contraptions and the base.", "One link transmits, its twin receives, across any distance."]
	quest.6091AE070476DB48.title: "Redstone Link"
	quest.61384D5A42B93834.quest_desc: ["Dropped by the Nightmare."]
	quest.61384D5A42B93834.title: "Nightmare Scale"
	quest.616EAC0708E2EF90.quest_desc: ["A crafting grid inside the backpack. Smelting, stonecutting and blasting variants exist too."]
	quest.616EAC0708E2EF90.title: "Crafting Upgrade"
	quest.619D3C9D28CBCD62.quest_desc: ["Mekanism tanks hold buckets by the dozen and upgrade upward.", "Dynamic tanks scale to multiblock size later."]
	quest.619D3C9D28CBCD62.title: "Fluid Tanks"
	quest.61CF2F9D4B616419.quest_desc: ["Ultimate Sword, Lucid eye, Basilisk fang, Emperor stinger, Stratoshark fin, Kraken tentacle AND tooth.", "Seven rarities, one cutting edge. Do not lose it."]
	quest.61CF2F9D4B616419.title: "Big Bertha Blade"
	quest.61DB15007645A618.quest_desc: ["Roomier still."]
	quest.61DB15007645A618.title: "Gold Backpack"
	quest.62D262AA36968D2D.quest_desc: ["Storage upgrades multiply capacity from iron up through gold, diamond, emerald and netherite.", "Sneak-right-click the controller to feed upgrades into the whole network at once."]
	quest.62D262AA36968D2D.title: "Drawer Upgrades"
	quest.641CF9A9B2EFF048.quest_desc: ["Serious bulk storage for serious automation.", "One cell per material network."]
	quest.641CF9A9B2EFF048.title: "64k Storage Cell"
	quest.648C33EF5C50D3BF.quest_desc: ["Enchanted gear, damaged tools and anything with extra data does not stack.", "Keep that stuff in chests or bags. Feeding it into a digital system bloats the drive with thousands of unique entries."]
	quest.648C33EF5C50D3BF.title: "NBT and YOU!"
	quest.649A8D3788538C80.quest_desc: ["Poisons what you hit, and fires a venom blast."]
	quest.649A8D3788538C80.title: "Pufferfish Pet"
	quest.66902790EAFD0729.quest_desc: ["Searches every cell from one screen.", "The face of the system."]
	quest.66902790EAFD0729.title: "ME Terminal"
	quest.670F1DFE159F3B33.quest_desc: ["They swarm every corner of Thoraxis, hatching from nests and surface clusters.", "Squash them for the advancement."]
	quest.670F1DFE159F3B33.title: "Kill a Bed Bug"
	quest.6858822C00824705.quest_desc: ["Two ways to meet it: killing a squid while you have Bad Omen can summon it, and each Bad Omen level raises the odds, or find an Easter Bunny in a rainbow-ant dimension and wait for it to lay a Kraken egg.", "The hardest boss in the mod: it flies, calls lightning, and fires Octopus Bombs and Missile Squids.", "Bring one Tentacle and one Tooth for the Big Bertha blade."]
	quest.6858822C00824705.title: "Kill the Kraken"
	quest.6AA39F9193D053E6.quest_desc: ["Collect every one of the area pets around this quest."]
	quest.6AA39F9193D053E6.title: "Area Pets"
	quest.6B10301A0D908130.quest_desc: ["Dropped by Toreterror."]
	quest.6B10301A0D908130.title: "Primordial Scute"
	quest.6B1F8FD97675DF68.quest_desc: ["It haunts the Nightmare Wastes and Umbral Hills of Thoraxis.", "Expect your gravity to flip.", "Its scale feeds the Big Bertha hilt."]
	quest.6B1F8FD97675DF68.title: "Kill the Nightmare"
	quest.6B4FE35EC75A476E.quest_desc: ["Treats every connected chest as one big storage, up to 14 blocks out in all directions.", "It doubles as the in and out point for pipes and digital systems."]
	quest.6B4FE35EC75A476E.title: "Storage Controller"
	quest.6B6129EE83D022CF.quest_desc: ["Enchant on the go."]
	quest.6B6129EE83D022CF.title: "Enchanting Table Pet"
	quest.6B9F7D9034C88F24.quest_desc: ["Wirelessly joins far chests into the controller network. Bind with the storage tool: controller first, then chests.", "Same 14-block reach, none of the trim tunnels."]
	quest.6B9F7D9034C88F24.title: "Storage Link"
	quest.6C3CC466DF3D88BE.quest_desc: ["Shift + use to cycle boss modes:", "Basilisk paralyzes and poisons, Lucid inverts gravity, Nightmare spreads dread,", "Kraken slams and calls lightning, Hercules launches foes skyward,", "Molevore drills through blocks, Toreterror crashes down with an AOE shockwave."]
	quest.6C3CC466DF3D88BE.title: "BIG BERTHA"
	quest.6D508C05CB7BA59E.quest_desc: ["Pushes network stock into machines and chests.", "The backbone of auto-processing."]
	quest.6D508C05CB7BA59E.title: "Export Kabel"
	quest.6D8CD5CBA8CE7BFA.quest_desc: ["In The End, you'll find the final boss of Vanilla Minecraft: The Ender Dragon.", "At the top of each pillar of Obsidian, you'll find an End Crystal that heals the Dragon. Make sure to take those out first! They also do a lot of damage, so make sure to create some distance!", "Once defeated, a Dragon Egg spawns at the top of the Exit Portal. This cannot be mined like normal blocks, but is affected by gravity."]
	quest.6D8CD5CBA8CE7BFA.title: "Kill the Ender Dragon"
	quest.6DC3B26B2B88FCB1.quest_desc: ["Upgradable backpacks that ride in the curios back slot and take filters for nifty tricks.", "They dye too, so the whole server can color-code."]
	quest.6DC3B26B2B88FCB1.title: "Sophisticated Backpacks"
	quest.706ABC3111A615C2.quest_desc: ["Bonus drops from mobs and mining."]
	quest.706ABC3111A615C2.title: "Loot Pet"
	quest.707341E3F0EEAE0C.quest_desc: ["Antarchy ores are rarer than diamond and drop a single nugget each.", "Nine make an ingot."]
	quest.707341E3F0EEAE0C.title: "Uranium Nugget"
	quest.71902E9FC13770FE.quest_desc: ["A cable that only lets chosen items through.", "Keeps sorted lines sorted."]
	quest.71902E9FC13770FE.title: "Filter Kabel"
	quest.728535329B6CABAE.quest_desc: ["Mekanism's own digital storage: hyper-dense drives on one array.", "Importers and exporters wire it into the factory."]
	quest.728535329B6CABAE.title: "QIO Drive Array"
	quest.73B7502A7CE903EA.quest_desc: ["Oversees the whole network and buffers transfers.", "Optional until the network grows teeth."]
	quest.73B7502A7CE903EA.title: "Flux Controller"
	quest.74371D87F77252BF.quest_desc: ["Brewed from corn. One goes into every Rainbow Sugar, and Rainbow Sugar feeds the Big Bertha hilt."]
	quest.74371D87F77252BF.title: "High Fructose Corn Syrup"
	quest.7529B626BA315E9A.quest_desc: ["Collect 30 different pets."]
	quest.7529B626BA315E9A.title: "Pet Scientist"
	quest.755A9B6A2486D364.quest_desc: ["Belts, funnels and chutes move items the scenic route, with no power bill.", "Start with belt connectors, then funnel in and out of chests and machines.", "Extend lines with more connectors, and mind the rotation direction."]
	quest.755A9B6A2486D364.title: "Create"
	quest.757E0BBF7CF30F7D.quest_desc: ["Every upgrade moves more per operation. Basic adds redstone control, Improved adds routing modes like round-robin, Advanced unlocks filters, Ultimate just moves a lot."]
	quest.757E0BBF7CF30F7D.title: "Pipe Upgrades"
	quest.75A00F759323E4AF.quest_desc: ["Moving thousands of items between chests, machines and farms by hand is not a plan.", "This chapter covers the pack's pipes: Pipez for simple runs, Mekanism for its machines, and Modular Routers for clever bits. Grab a wrench to start."]
	quest.75A00F759323E4AF.title: "Logistics"
	quest.7912EAAEAB3E5D3B.quest_desc: ["Made from every other pet, and can transform into any of them."]
	quest.7912EAAEAB3E5D3B.title: "Meta Pet"
	quest.794098D78CD9BD42.quest_desc: ["Moving thousands of items between chests, machines and farms by hand is not a plan.", "This chapter covers the pack's pipes: Pipez for simple runs, Mekanism for its machines, and Modular Routers for clever bits. Grab a wrench to start."]
	quest.794098D78CD9BD42.title: "Pipez"
	quest.7983697A655600AE.quest_desc: ["Mekanism machines are picky: each side must be set to input, output or off in the machine GUI.", "The configurator flips sides between pull and push. Get one before laying a single pipe."]
	quest.7983697A655600AE.title: "Mekanism"
	quest.7B48AA1D703B5B22.quest_desc: ["Dropped by Praying Mantises - Alpha Mantises drop them too."]
	quest.7B48AA1D703B5B22.title: "Mantis Claw"
	quest.7BBC706328090A22.quest_desc: ["An input-output point for the controller network: pipes push in and pull out through it.", "One I/O per wall is usually enough."]
	quest.7BBC706328090A22.title: "Controller I/O"
	quest.7C4E406EC577C304.quest_desc: ["Chests vacuum nearby drops into themselves.", "Turn it off before parties."]
	quest.7C4E406EC577C304.title: "Pickup Upgrade"
	quest.7D319BB781227B4F.quest_desc: ["Pets are crafted, then work while you carry them.", "Hover a pet to see its powers, controls and favorite food.", "Pets get hungry; Sated versions never do."]
	quest.7D319BB781227B4F.title: "First Steps"
	quest.7DB46DA33E716767.quest_desc: ["Searches the whole cable network from one screen and pulls what you need.", "Pair with the remote to browse your stock from anywhere."]
	quest.7DB46DA33E716767.title: "Request Tablet"
	quest.7DC64DC3FE15A9D9.quest_desc: ["Presses circuits for processors and cards.", "Name a press, feed the middle, collect below."]
	quest.7DC64DC3FE15A9D9.title: "Inscriber"
	quest.7E2BB82AF06BA4A5.quest_desc: ["yum"]
	quest.7E2BB82AF06BA4A5.title: "Cooked Corndog"
	quest.7E7A788DF7806180.quest_desc: ["Single-item bulk storage that upgrades through the tiers.", "A drawer equivalent for the Mekanism corner."]
	quest.7E7A788DF7806180.title: "Mekanism Bins"
	quest.7F59786D1353134D.quest_desc: ["Follow a termite - or kill one inside a Myrmite portal frame.", "An infested dimension of escalating hordes.", "The Hercules Beetle, Molevore waves and Jerry eggs wait inside."]
	quest.7F59786D1353134D.title: "Cavaryn"
	quest.7F85B0D935283536.quest_desc: ["Offers encoded patterns to the autocrafting network.", "Pair with molecular assemblers."]
	quest.7F85B0D935283536.title: "Pattern Provider"
	quest.7F8D2F3FBC9C28BE.quest_desc: ["Dropped by the Hercules Beetle."]
	quest.7F8D2F3FBC9C28BE.title: "Hercules Horn"
	quest.141707DC8770F0B6.quest_desc: ["Hatch the Prince Egg and feed the hatchling golden items until it grows.", "A grown Prince can be tamed and saddled for flight."]
	quest.141707DC8770F0B6.title: "Long Live the Prince"
	quest.19635F3E1FC4BE40.quest_desc: ["The Kraken needs no portal, only the sea."]
	quest.19635F3E1FC4BE40.title: "The Overworld"
	quest.21CC719DB7052664.quest_desc: ["She rules the Underside of Thoraxis, reached through the gravity throats.", "She bends gravity and time, and her Manticores finish what she starts.", "Drops Queen Scales for Royal Assailant gear, and a Princess Egg."]
	quest.21CC719DB7052664.title: "Kill the Queen"
	quest.52EDD018CBF9952F.quest_desc: ["Wound it in combat, then feed it Broodfruit to pacify it.", "It bonds with whoever fed it."]
	quest.52EDD018CBF9952F.title: "Tame the Hercules Beetle"
	quest.575DF7EE5C1FAA9F.quest_desc: ["He rules alone from the King's Tree in Elythia.", "Mid-fight he issues Decrees like KNEEL and DO NOT RUN; break one and your hearts are halved for thirty seconds.", "Drops King Scales for Royal Guardian gear, and a Prince Egg."]
	quest.575DF7EE5C1FAA9F.title: "Kill the King"
	quest.6408726B64551FDF.quest_desc: ["Hatch the Princess Egg and feed the hatchling golden items until it grows.", "A grown Princess can be tamed and saddled, and slows enemies with time-dilation fields."]
	quest.6408726B64551FDF.title: "Long Live the Princess"
	chapter.6A00AABBCCDDEEFF.title: "Mystical Agriculture"
	quest.6A01000000000001.quest_desc: ["Mine it from the ground. Half of every MA recipe starts here."]
	quest.6A01000000000001.title: "Prosperity Shards"
	quest.6A01000000000002.quest_desc: ["The in-game manual. Read it before anything else."]
	quest.6A01000000000002.title: "Mystical Agriculture Guide"
	quest.6A01000000000003.quest_desc: ["The seed every other seed is built from."]
	quest.6A01000000000003.title: "Prosperity Seed Base"
	quest.6A01000000000004.quest_desc: ["One altar, eight pedestals. The seed crafter. Wand or redstone to start."]
	quest.6A01000000000004.title: "Infusion Altar"
	quest.6A01000000000005.quest_desc: ["A Mystical Agriculture milestone."]
	quest.6A01000000000005.title: "Unattuned Augment"
	quest.6A01000000000006.quest_desc: ["A Mystical Agriculture milestone."]
	quest.6A01000000000006.title: "Seed Reprocessor"
	quest.6A01000000000007.quest_desc: ["A Mystical Agriculture milestone."]
	quest.6A01000000000007.title: "Master Infusion Crystal"
	quest.6A01000000000008.quest_desc: ["A Mystical Agriculture milestone."]
	quest.6A01000000000008.title: "Tinkering Table"
	quest.6A01000000000009.quest_desc: ["A Mystical Agriculture milestone."]
	quest.6A01000000000009.title: "Soulium Spawner"
	quest.6A0100000000000A.quest_desc: ["Grows ice. Plant on essence farmland."]
	quest.6A0100000000000A.title: "Ice Seeds"
	quest.6A0100000000000B.quest_desc: ["Matching-tier crops can drop bonus seeds here."]
	quest.6A0100000000000B.title: "Inferium Farmland"
	quest.6A0100000000000C.quest_desc: ["Grows earth. Plant on essence farmland."]
	quest.6A0100000000000C.title: "Earth Seeds"
	quest.6A0100000000000D.quest_desc: ["Grows water. Plant on essence farmland."]
	quest.6A0100000000000D.title: "Water Seeds"
	quest.6A0100000000000E.quest_desc: ["Grows dirt. Plant on essence farmland."]
	quest.6A0100000000000E.title: "Dirt Seeds"
	quest.6A0100000000000F.quest_desc: ["Grows stone. Plant on essence farmland."]
	quest.6A0100000000000F.title: "Stone Seeds"
	quest.6A01000000000010.quest_desc: ["Grows deepslate. Plant on essence farmland."]
	quest.6A01000000000010.title: "Deepslate Seeds"
	quest.6A01000000000011.quest_desc: ["Grows fire. Plant on essence farmland."]
	quest.6A01000000000011.title: "Fire Seeds"
	quest.6A01000000000012.quest_desc: ["Grows wood. Plant on essence farmland."]
	quest.6A01000000000012.title: "Wood Seeds"
	quest.6A01000000000013.quest_desc: ["Kills that fill soul jars. The dagger does the reaping."]
	quest.6A01000000000013.title: "Soulium Tools"
	quest.6A01000000000014.quest_desc: ["The first essence. Mine inferium ore to get going."]
	quest.6A01000000000014.title: "Inferium Essence"
	quest.6A01000000000015.quest_desc: ["A Mystical Agriculture milestone."]
	quest.6A01000000000015.title: "Inferium Growth Accelerator"
	quest.6A01000000000016.quest_desc: ["A filling snack grown from inferium essence."]
	quest.6A01000000000016.title: "Inferium Apple"
	quest.6A01000000000017.quest_desc: ["Tough essence armor with an augment slot. Repairs with essence ingots."]
	quest.6A01000000000017.title: "Inferium Armor"
	quest.6A01000000000018.quest_desc: ["Any inferium tool counts toward this."]
	quest.6A01000000000018.title: "Inferium Tools"
	quest.6A01000000000019.quest_desc: ["A Mystical Agriculture milestone."]
	quest.6A01000000000019.title: "Infusion Crystal"
	quest.6A0100000000001A.quest_desc: ["Grows air. Plant on essence farmland."]
	quest.6A0100000000001A.title: "Air Seeds"
	quest.6A0100000000001B.quest_desc: ["A Mystical Agriculture milestone."]
	quest.6A0100000000001B.title: "Prudentium Farmland"
	quest.6A0100000000001C.quest_desc: ["Grows coral. Plant on essence farmland."]
	quest.6A0100000000001C.title: "Coral Seeds"
