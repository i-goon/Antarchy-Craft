	quest.6C3CC466DF3D88BE.quest_desc: [
		"Shift + use to cycle boss modes:"
		"Basilisk paralyzes and poisons, Lucid inverts gravity, Nightmare spreads dread,"
		"Kraken slams and calls lightning, Hercules launches foes skyward,"
		"Molevore drills through blocks, Toreterror crashes down with an AOE shockwave."
	]
	quest.6C3CC466DF3D88BE.title: "BIG BERTHA"
	quest.6D8CD5CBA8CE7BFA.quest_desc: [
		"In The End, you'll find the final boss of Vanilla Minecraft: The Ender Dragon."
		"At the top of each pillar of Obsidian, you'll find an End Crystal that heals the Dragon. Make sure to take those out first! They also do a lot of damage, so make sure to create some distance!"
		"Once defeated, a Dragon Egg spawns at the top of the Exit Portal. This cannot be mined like normal blocks, but is affected by gravity."
	]
	quest.6D8CD5CBA8CE7BFA.title: "Kill the Ender Dragon"
