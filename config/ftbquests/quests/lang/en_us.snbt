	quest.0604BD805637B627.title: "Chutes"
	quest.08891A0092241756.quest_desc: ["Deep pockets."]
	quest.08891A0092241756.title: "Diamond Backpack"
	quest.099B848E75ABBBCE.quest_desc: ["Bluestone torches, quartz and stone.", "Antarchy's answer to redstone, same job."]
	quest.099B848E75ABBBCE.title: "Bluestone Comparator"
	quest.099EEF71849D646F.quest_desc: ["It drifts over the Lucid Pools of Thoraxis, hurling bolts that invert your gravity.", "You need two Eyes of Dreams: one for the blade, one for the Gravity Gun."]
	quest.099EEF71849D646F.title: "Kill the Lucid"
	quest.09D0FEC1B1CFEF03.quest_desc: ["Smelts the first smeltable item in your hotbar."]
	quest.09D0FEC1B1CFEF03.title: "Furnace Pet"
	quest.0A0F0008E0D1CC79.quest_desc: ["Damage you deal heals you, and it fires wither skulls."]
	quest.0A0F0008E0D1CC79.title: "Wither Pet"
	quest.0B926C1EBC72C321.quest_desc: ["Bonemeals crops and fills empty bowls with mushroom stew."]
	quest.0B926C1EBC72C321.title: "Mooshroom Pet"
	quest.0BA163F30788EA2E.quest_desc: ["Feeds Forge power into the ME network.", "One per network is usually enough."]
	quest.0BA163F30788EA2E.title: "Energy Acceptor"
	quest.0BE25B9BEA5F1E7E.quest_desc: ["It guards the Ruined Arena in Elythia's meadows and Truffalo Forest.", "A few also turn up among Overworld mantises.", "Its claw feeds the Big Bertha weapon line."]
	quest.0BE25B9BEA5F1E7E.title: "Kill the Alpha Mantis"
	quest.0C1AFCCD54FA31AA.quest_desc: ["Funnels pull from inventories above and push into belts and chutes.", "Brass funnels filter too. Point the spout where things should go."]
	quest.0C1AFCCD54FA31AA.title: "Funnels"
	quest.0CF6EE642D83E1E8.quest_desc: ["It hatches from the massive cocoon in Elythia.", "Its wing crafts the Brutalfly Elytra - and feeds the Big Bertha weapon line, so don't lose it."]
	quest.0CF6EE642D83E1E8.title: "Kill the Brutalfly"
	quest.0D0EC09FB5E55A96.quest_desc: ["Pushes matching items from the router into the facing inventory.", "Regulate amounts and redstone behavior in the module GUI."]
	quest.0D0EC09FB5E55A96.title: "Sender Module"
	quest.0E9821755DE5F440.quest_desc: ["Wireless power: plugs feed the network, points drink from it.", "Configure both with the configurator on the same network name."]
	quest.0E9821755DE5F440.title: "Flux Networks"
	quest.0ED597DDAB4D1972.quest_desc: ["A depot stages one stack where belts, funnels and players meet.", "Basins do the same job for processing recipes."]
	quest.0ED597DDAB4D1972.title: "Depot"
	quest.1001AABBCCDDEEFF.quest_desc: ["The first boss of the Twilight Forest.", "Find the Naga Courtyard in the forest. The Naga circles the arena and charges through blocks. Bring a shield and keep moving."]
	quest.1001AABBCCDDEEFF.title: "The Naga"
	quest.1002AABBCCDDEEFF.quest_desc: ["At the top of the Lich Tower.", "Three phases. Reflect his Ender Pearl shots to break the shields, melee him when he summons zombies, then finish him when he swaps to a sword."]
	quest.1002AABBCCDDEEFF.title: "The Twilight Lich"
	quest.1003AABBCCDDEEFF.quest_desc: ["The Labyrinth under the Swamp.", "Use a Maze Map or follow the walls to find the Minoshroom. Eat the Meef Stroganoff it drops to unlock the Fire Swamp."]
	quest.1003AABBCCDDEEFF.title: "Minoshroom"
	quest.1004AABBCCDDEEFF.quest_desc: ["In the Fire Swamp.", "The Hydra has many heads. Ranged is weak so fight up close and keep moving to avoid fire. Defeating it opens the Dark Forest."]
	quest.1004AABBCCDDEEFF.title: "Hydra"
	quest.1005AABBCCDDEEFF.quest_desc: ["Inside the Dark Forest Stronghold.", "Place any boss trophy on the pedestal to enter. Six Knight Phantoms fight together on the third layer."]
	quest.1005AABBCCDDEEFF.title: "Knight Phantoms"
	quest.1006AABBCCDDEEFF.quest_desc: ["At the top of the Dark Tower.", "Find the reappearing blocks at the base to climb the maze. Ghast traps powered by Ghastlings can help, a bow works too."]
	quest.1006AABBCCDDEEFF.title: "Ur-Ghast"
	quest.1007AABBCCDDEEFF.quest_desc: ["In the Snowy Forest.", "Find the large Yeti Cave. The Alpha Yeti throws ice blocks, a bow helps."]
	quest.1007AABBCCDDEEFF.title: "Alpha Yeti"
	quest.1008AABBCCDDEEFF.quest_desc: ["At the top of the Aurora Palace in the Glacier.", "She summons ice crystals and slams ice that breaks the floor. Hit her upper half while dodging. Defeating her unlocks the Highlands."]
	quest.1008AABBCCDDEEFF.title: "Snow Queen"
	quest.1077E6D8B10D7B23.quest_desc: ["Mekanism power cables, speaking every energy dialect.", "Watch the tier: a basic cable on a power-hungry line throttles it."]
	quest.1077E6D8B10D7B23.title: "Universal Cables"
	quest.10845E332C012581.quest_desc: ["It forms the core of Big Bertha's blade."]
	quest.10845E332C012581.title: "The Ultimate Sword"
	quest.11A8FAFA9EAA3CD7.quest_desc: ["Shoots fireballs."]
	quest.11A8FAFA9EAA3CD7.title: "Ghast Pet"
